# Copy to .env (never committed). Everything here is optional; the app works without it, just with less.
# Gmail: Google Account → Security → 2-Step Verification → App passwords → create one for "Mail".
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Treg (contact emails). Without it, people show with LinkedIn only.
TREG_API_KEY=
# Set to 0 to stop the app starting a search run by itself when opened (useful while testing).
# COPILOT_AUTORUN=0
